#!/bin/bash
# Regenerate plugins/jstack from upstream pstack: fetch the pinned commit,
# keep skills/agents/LICENSE, rename, substitute, patch, relock, check, test.
# Never edit plugins/jstack by hand: change jstack/substitutions.tsv or
# jstack/patches instead.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd -P)"
out="$root/plugins/jstack"
apply_patches=true
while [ $# -gt 0 ]; do
  case $1 in
    --no-patches) apply_patches=false ;;
    --out) out="$2"; shift ;;
    *) echo "usage: sync-jstack [--no-patches] [--out DIR]" >&2; exit 2 ;;
  esac
  shift
done

die() { echo "sync-jstack: $*" >&2; exit 1; }
command -v bun > /dev/null || die "bun: not found (mise install bun)"

# repo=, path=, commit= (a full SHA: a short one can be shadowed by an upstream
# tag or branch of the same name, or collide as the repo grows)
repo=$(sed -n 's/^repo=//p' "$root/jstack/upstream")
path=$(sed -n 's/^path=//p' "$root/jstack/upstream")
commit=$(sed -n 's/^commit=//p' "$root/jstack/upstream")
[[ $commit =~ ^[0-9a-f]{40}$ ]] || die "fetch: commit in jstack/upstream must be a full 40-character SHA"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

git clone -q --filter=blob:none --no-checkout "$repo" "$work/src" || die "fetch: clone failed"
git -C "$work/src" sparse-checkout set "$path"
git -C "$work/src" checkout -q --detach "$commit^{commit}" || die "fetch: commit $commit not found"
[ "$(git -C "$work/src" rev-parse HEAD)" = "$commit" ] || die "fetch: checked out something other than $commit"
src="$work/src/$path"

stage="$work/jstack"
mkdir -p "$stage/.claude-plugin"
cp -R "$src/skills" "$src/agents" "$src/LICENSE" "$stage/"
# bun runs below on upstream files: refuse config that would redirect or
# extend it (registry, preload scripts), and links that would be published
rogue=$(find "$stage" -name bunfig.toml -o -name .npmrc -o -type l)
[ -z "$rogue" ] || die "fetch: upstream ships files sync won't run bun next to: ${rogue//$stage\//}"
mv "$stage/skills/poteto-mode" "$stage/skills/j-mode"
mv "$stage/skills/setup-pstack" "$stage/skills/setup-jstack"
mv "$stage/agents/poteto-agent.md" "$stage/agents/j-agent.md"
# Drives Cursor's hosted agents (routines, update_state, SendToUser webhooks):
# nothing in Claude Code to translate it to
rm -rf "$stage/skills/make-bot-ui"
# poteto-help describes Cursor Custom Modes and links docs this sync never
# copies; ketchup-video needs a video renderer; statechart installs npm
# packages with unpinned transitive dependencies plus TLC and Java (~305 MB)
# on first use
rm -rf "$stage/skills/poteto-help" "$stage/skills/ketchup-video" "$stage/skills/statechart"

# Whole-word literal substitutions, in file order: where a term starts or
# ends with a letter or digit, a match touching another one there is left
# alone ("Upstack" must not become "Ujstack"). Text files only: bun.lock is
# regenerated below, LICENSE keeps the upstream notice.
while IFS=$'\t' read -r from to; do
  if [ -z "$from" ] || [ "${from:0:1}" = "#" ]; then continue; fi
  { grep -rlF --exclude=bun.lock --exclude=LICENSE -- "$from" "$stage" || true; } \
    | while read -r f; do
      FROM="$from" TO="$to" perl -pi -e '
        BEGIN {
          $re = quotemeta $ENV{FROM};
          $re = "(?<![A-Za-z0-9])$re" if $ENV{FROM} =~ /^[A-Za-z0-9]/;
          $re = "$re(?![A-Za-z0-9])" if $ENV{FROM} =~ /[A-Za-z0-9]$/;
        }
        s/$re/$ENV{TO}/g' "$f"
    done
done < "$root/jstack/substitutions.tsv"

if [ "$apply_patches" = true ]; then
  git -C "$stage" init -q # git apply resolves paths against a repo
  for p in "$root"/jstack/patches/*.patch; do
    git -C "$stage" apply --whitespace=nowarn "$p" || die "patch: ${p##*/} no longer applies"
  done
  rm -rf "$stage/.git"
fi

# Version omitted on purpose: Claude Code then tracks this repo's commits
# instead of pinning installs to a version string. No skills/agents keys: the
# default skills/ and agents/ dirs are scanned, and "agents" accepts only .md
# files (a directory fails validation)
cat > "$stage/.claude-plugin/plugin.json" << 'JSON'
{
  "name": "jstack",
  "description": "Jason's agent workflows: j-mode router, design and review panels, verification, principles. Fork of pstack by Lauren Tan (MIT).",
  "author": { "name": "Jason Matherly" },
  "types": "./types/index.d.ts",
  "license": "MIT"
}
JSON

scripts="$stage/skills/j-mode/scripts"
(cd "$scripts" && bun install --lockfile-only --ignore-scripts > /dev/null) || die "relock: bun install --lockfile-only failed"
# JSTACK_NO_CHECK=1: patch-authoring escape hatch (README, "Patch workflow")
if [ "${JSTACK_NO_CHECK:-}" != 1 ]; then
  "$root/scripts/check-jstack" "$stage" || die "check: see above"
fi
if [ "$apply_patches" = true ] && [ "${JSTACK_NO_CHECK:-}" != 1 ]; then
  # Only runtime dependencies, and no install scripts (dependencies' never run)
  (cd "$scripts" && bun install --frozen-lockfile --production --ignore-scripts > /dev/null &&
    bun test orch watch-pr check-plan.test.ts > /dev/null 2>&1) \
    || die "test: bun test failed in skills/j-mode/scripts"
  rm -rf "$scripts/node_modules"
  # 20-runtime.patch rewrote worktree-audit.sh's transcript lookup
  bash "$root/jstack/tests/worktree-audit.sh" "$scripts/worktree-audit.sh" > /dev/null \
    || die "test: jstack/tests/worktree-audit.sh failed"
  bash "$root/jstack/tests/check-jstack-types.sh" > /dev/null \
    || die "test: jstack/tests/check-jstack-types.sh failed"
fi

rm -rf "$out" && mkdir -p "$(dirname "$out")" && mv "$stage" "$out"
echo "sync-jstack: $out from $repo@$commit"
