#!/bin/bash
# Validate a generated jstack tree (default plugins/jstack): no upstream names
# or Cursor-only references, valid frontmatter, live links, and every skill a
# skill names actually exists (most are disable-model-invocation, so a dangling
# name can't fall back to the Skill tool).
set -uo pipefail
root="$(cd "$(dirname "$0")/.." && pwd -P)"
no_types=false
if [ "${1:-}" = --no-types ]; then no_types=true; shift; fi # CI has no declarations; validate and test still run
dir="${1:-$root/plugins/jstack}"
dir="$(cd "$dir" 2> /dev/null && pwd -P)" || { echo "check-jstack: no such directory: ${1:-plugins/jstack}" >&2; exit 2; }
fail=0
bad() { echo "$*" >&2; fail=1; }

forbidden='\bpoteto|\bpstack\b|[A-Za-z]jstack|lauren|~/\.cursor|\.cursor/|\bCursor\b|AskQuestion\b|generalPurpose|cursor-team-kit|\bdeslop\b|control-ui|control-cli|\bcreate-skill\b|agent-transcripts|environment: "cloud"|gpt-5\.|claude-opus-[0-9-]+-(max|xhigh|high|medium)|\.mdc\b|is_background|\bTask tool\b|\bTask spawn\b|[Gg]rok\b|composer-|/visualize|^mode: true|^icon:|^reminder:'
while IFS= read -r hit; do bad "$hit: upstream/Cursor reference"; done \
  < <(grep -rnEI --exclude=LICENSE --exclude=bun.lock --exclude=plugin.json "$forbidden" "$dir")

for f in "$dir"/skills/*/SKILL.md; do
  [ -e "$f" ] || continue # bash 3.2 has no nullglob: an empty skills/ yields the pattern itself
  d="$(basename "$(dirname "$f")")"
  name="$(awk 'NR>1 && /^---$/{exit} /^name: /{sub(/^name: */,""); print; exit}' "$f")"
  [ "$name" = "$d" ] || bad "$f: name '$name' != directory '$d'"
  grep -q '^description: ' "$f" || bad "$f: no description"
done

while IFS=: read -r f _ m; do
  t="${m#*(}"; t="${t%)}"
  case $t in */* | *.*) ;; *) continue ;; esac # placeholders like (url) in prompt templates
  [ -e "$(dirname "$f")/$t" ] || bad "$f: broken link $t"
done < <(grep -rnoE --include='*.md' '\]\([^):#]+\)' "$dir")

# Every "**name** skill" / "**name** principle skill" must name a real skill
# folder (most are disable-model-invocation, so they're read by path)
skills=$(ls "$dir/skills")
while IFS=: read -r f _ ref; do
  ref="${ref#\*\*}"
  ref="${ref%%\*\**}"
  # coding-standards is installed on its own (skills/ in this repo, Skills CLI)
  [ "$ref" = coding-standards ] && continue
  grep -qx "$ref" <<< "$skills" || bad "$f: references missing skill '$ref'"
done < <(grep -rnoE --include='*.md' '\*\*[a-z][a-z0-9-]*\*\*( and \*\*[a-z][a-z0-9-]*\*\*)? (principle )?skill' "$dir" \
  | sed -E 's/^([^:]+:[0-9]+:)\*\*([a-z0-9-]+)\*\* and \*\*([a-z0-9-]+)\*\*.*/\1**\2**\n\1**\3**/')

# Every backticked `/name` must be a jstack skill, a Claude Code built-in, or a
# plugin command the fork names on purpose (`/jstack:<skill>`, `/skill-creator:skill-creator`)
builtins='simplify loop tasks code-review clear branch'
while IFS=: read -r f _ ref; do
  ref="${ref#\`/}"; ref="${ref%\`}"
  case $ref in
    jstack:*) grep -qx "${ref#jstack:}" <<< "$skills" || bad "$f: /$ref names a missing jstack skill" ;;
    skill-creator:skill-creator) ;;
    *:*) bad "$f: /$ref names another plugin's command" ;;
    *) grep -qx "$ref" <<< "$skills" || grep -qw "$ref" <<< "$builtins" || bad "$f: /$ref is neither a jstack skill nor a Claude Code built-in" ;;
  esac
done < <(grep -rnoE --include='*.md' '`/[a-z][a-z0-9-]*(:[a-z][a-z0-9-]*)?`' "$dir/skills" "$dir/agents")

# Nothing upstream may grant itself tools, hooks or servers, or smuggle in
# links that would be committed and published
while IFS= read -r hit; do bad "$hit: frontmatter key not allowed in jstack"; done \
  < <(grep -rnE --include='*.md' '^(allowed-tools|hooks|mcpServers|permissionMode):' "$dir/skills" "$dir/agents")
while IFS= read -r link; do bad "$link: symlink"; done < <(find "$dir" -type l)

grep -q 'Copyright (c) 2026 Lauren Tan' "$dir/LICENSE" || bad "LICENSE: upstream notice missing"
claude plugin validate "$dir" > /dev/null 2>&1 || bad "claude plugin validate $dir failed"
# validate and test do not type-check (GitHub issue #99771), so tsc runs against the engine's own declarations.
# /plugin-authoring writes them for the running version under the per-user temp folder, which macOS's tmp_cleaner
# empties after 3 idle days, so a found copy is kept under ~/.cache/jstack too (README, Refresh the mod types)
have=$(claude --version | cut -d' ' -f1)
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/jstack"
resolve_types() {
  if [ -n "${JSTACK_CLAUDE_TYPES:-}" ]; then echo "$JSTACK_CLAUDE_TYPES"; return; fi
  local found
  found=$(ls -t "${JSTACK_TYPES_TMP:-/tmp/claude-$(id -u)}"/bundled-skills/"$have"/*/plugin-authoring/types/claude-code.d.ts 2> /dev/null | head -1)
  if [ -n "$found" ]; then
    mkdir -p "$cache_dir" && cp "$found" "$cache_dir/claude-code-$have.d.ts"
    echo "$found"; return
  fi
  if [ -f "$cache_dir/claude-code-$have.d.ts" ]; then echo "$cache_dir/claude-code-$have.d.ts"; return; fi
  ls -t "$cache_dir"/claude-code-*.d.ts 2> /dev/null | head -1
}
tsdir=$(mktemp -d)
trap 'rm -rf "$tsdir"' EXIT
types=$([ "$no_types" = true ] || resolve_types)
if [ "$no_types" = true ]; then
  :
elif [ ! -f "$types" ]; then
  if [ -n "${JSTACK_CLAUDE_TYPES:-}" ]; then
    bad "JSTACK_CLAUDE_TYPES=$types: not found"
  else
    bad "claude-code.d.ts for Claude Code $have: not found, run /plugin-authoring once (README, Refresh the mod types)"
  fi
elif ! command -v tsc > /dev/null; then
  bad "tsc: not found (mise install npm:typescript)"
else
  echo "check-jstack: declarations from $types" >&2
  built=$(sed -n '1s/.*Claude Code \([0-9][0-9.]*[0-9]\).*/\1/p' "$types")
  [ "$built" = "$have" ] || echo "check-jstack: $types is from $built, claude is $have" >&2
  cat > "$tsdir/tsconfig.json" << JSON
{
  "compilerOptions": { "target": "es2023", "lib": ["es2023"], "types": [], "module": "esnext", "moduleResolution": "bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "noEmit": true, "skipLibCheck": true,
    "jsx": "react", "jsxFactory": "h", "jsxFragmentFactory": "Fragment" },
  "include": ["$types", "$dir/hooks", "$dir/types", "$dir/tests"]
}
JSON
  tsc -p "$tsdir/tsconfig.json" || bad "tsc: $dir does not type-check"
fi
# claude plugin test runs every *.test.ts(x) under the dir, and upstream's bun:test files cannot load in its sandbox
mkdir "$tsdir/mod"
for d in .claude-plugin hooks types tests; do
  if [ ! -d "$dir/$d" ]; then
    bad "$dir/$d: missing, the mod is incomplete"
  elif ! cp -R "$dir/$d" "$tsdir/mod/"; then
    bad "$dir/$d: copy into $tsdir/mod failed"
  fi
done
if [ "$fail" = 0 ]; then
  out=$(claude plugin test "$tsdir/mod" 2>&1) || bad "claude plugin test failed on $dir"$'\n'"$out"
fi
exit $fail
